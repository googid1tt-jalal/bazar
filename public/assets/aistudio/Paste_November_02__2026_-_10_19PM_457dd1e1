import express from 'express';
import cors from 'cors';
import axios from 'axios';
import * as cheerio from 'cheerio';

const app = express();
app.use(express.json());
app.use(cors());

interface ExtractedProduct {
  title: string;
  priceUsd?: number;
  retailPricePkr: number;
  imageUrl: string;
  description: string;
  category: string;
  sourcePlatform: 'Amazon' | 'Alibaba' | 'Daraz' | 'Markaz';
  originalUrl: string;
}

/**
 * Endpoint to fetch & parse product data from Amazon, Alibaba, Daraz, or Markaz
 */
app.post('/api/import-product', async (req, res) => {
  try {
    const { url, platform } = req.body;

    if (!url) {
      return res.status(400).json({ error: 'Product URL is required' });
    }

    let productData: ExtractedProduct;

    // Simulated robust scraping / API fetching based on platform
    if (platform === 'Amazon') {
      productData = await scrapeAmazonProduct(url);
    } else if (platform === 'Alibaba') {
      productData = await scrapeAlibabaProduct(url);
    } else if (platform === 'Daraz') {
      productData = await scrapeDarazProduct(url);
    } else {
      productData = await scrapeMarkazProduct(url);
    }

    return res.json({ success: true, product: productData });
  } catch (error: any) {
    console.error('Import error:', error.message);
    return res.status(500).json({ success: false, error: 'Failed to fetch product data from external platform.' });
  }
});

